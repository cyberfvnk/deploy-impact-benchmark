# =============================================================================
# Parâmetros de infraestrutura do cenário (lidos pelo docker-compose).
# Valores calibrados com dados de produção (README, seção 2).
# =============================================================================

# Partições: mesma proporção de produção (60 partições / 60 tasks -> 6 / 6).
REQUEST_PARTITIONS=6
RESPONSE_PARTITIONS=6

# Visibility timeout da fila SQS de entrada. Produção: 30s.
SQS_VISIBILITY_TIMEOUT=30 seconds

# Atraso do rebalance inicial do broker (padrão Kafka = 3000). Produção: padrão.
GROUP_INITIAL_REBALANCE_DELAY_MS=3000

# Latência da integração externa (responder). Produção: ~1s somando o fluxo todo.
LAT_INTEGRATION_BASE_MS=500
LAT_INTEGRATION_JITTER_MS=200
LAT_INTEGRATION_SLOW_RATE=0.01
LAT_INTEGRATION_SLOW_MS=2000
